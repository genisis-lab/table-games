+            aria-label={`Cell ${index + 1}${cell ? `, ${cell}` : ""}`}
+            disabled={!canMove || cell !== ""}
+            onClick={() => onMove({ column: index, piece })}
+            style= width: 46, height: 46, fontSize: 22, fontWeight: 700, display: "grid", placeItems: "center", borderRadius: 8 
+            key={index}
+          >
