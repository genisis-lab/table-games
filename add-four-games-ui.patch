+function MemoryMatchBoard({ room, canMove, onMove }: {
+  room: RoomSnapshot;
+  canMove: boolean;
+  onMove: (move: GameMove) => void;
+}) {
+  const meta = room.meta?.memoryMatch;
+  if (!meta) return null;
+  const columns = meta.columns;
+  const faceUp = new Set(meta.faceUp);
+  return (
+    <div className="memory-match-table" role="group" aria-label="Memory Match board" style= display: "flex", flexDirection: "column", alignItems: "center", gap: 14 >
+      <div className="memory-match-score" style= display: "flex", gap: 18 >
+        {(["p1", "p2"] as PlayerMark[]).map((mark) => (
+          <span className={room.turn === mark && !room.winner ? "active" : ""} style= fontWeight: room.turn === mark ? 700 : 400  key={mark}>
+            {playerNameFor(room.gameId, mark)} <strong>{meta.scores[mark]}</strong>
+          </span>
+        ))}
+        <span>Pairs left <strong>{meta.pairsRemaining}</strong></span>
+      </div>
+      <div className="memory-match-grid" role="group" aria-label="Cards" style={{ display: "grid", gridTemplateColumns: `repeat(${columns}, 56px)`, gap: 6 }}>
+        {meta.cards.map((card, index) => {
+          const revealed = card.matched || faceUp.has(index);
+          const icon = card.value >= 0 ? MEMORY_ICONS[card.value % MEMORY_ICONS.length] : "?";
+          return (
+            <button
+              type="button"
+              className={`memory-card ${revealed ? "face-up" : "face-down"} ${card.matched ? "matched" : ""}`}
+              aria-label={revealed ? `Card ${icon}` : `Hidden card ${index + 1}`}
+              disabled={!canMove || revealed}
+              onClick={() => onMove({ column: index })}
+              style= width: 56, height: 72, fontSize: 26, display: "grid", placeItems: "center", borderRadius: 8, opacity: card.matched ? 0.55 : 1 
+              key={index}
+            >
+              {revealed ? icon : "?"}
+            </button>
+          );
+        })}
+      </div>
+    </div>
+  );
+}
+
+function QuoridorBoard({ room, canMove, currentMark, onMove }: {
+  room: RoomSnapshot;
+  canMove: boolean;
+  currentMark?: PlayerMark;
+  onMove: (move: GameMove) => void;
+}) {
+  const meta = room.meta?.quoridor;
+  const [mode, setMode] = useState<"pawn" | "h" | "v">("pawn");
+  if (!meta) return null;
+  const size = meta.size;
+  const step = QUORIDOR_CELL + QUORIDOR_GAP;
+  const boardPx = size * QUORIDOR_CELL + (size - 1) * QUORIDOR_GAP;
+  const place = (row: number, column: number) => {
+    if (!canMove) return;
+    if (mode === "pawn") onMove({ row, column });
+    else onMove({ row, column, edge: mode });
+  };
+  return (
+    <div className="quoridor-table" role="group" aria-label="Quoridor board" style= display: "flex", flexDirection: "column", alignItems: "center", gap: 14 >
+      <div className="quoridor-status" style= display: "flex", gap: 16, alignItems: "center" >
+        <span>{currentMark === "p1" ? "You are South" : currentMark === "p2" ? "You are North" : "Spectating"}</span>
+        <span>Walls \u2014 {playerNameFor(room.gameId, "p1")} <strong>{meta.wallsRemaining.p1}</strong> \u00b7 {playerNameFor(room.gameId, "p2")} <strong>{meta.wallsRemaining.p2}</strong></span>
+      </div>
+      <div className="quoridor-modes" role="group" aria-label="Move mode" style= display: "flex", gap: 8 >
+        {([["pawn", "Move pawn"], ["h", "Wall \u2014"], ["v", "Wall |"]] as const).map(([value, label]) => (
+          <button type="button" className={mode === value ? "mode-button active" : "mode-button"} aria-pressed={mode === value} disabled={!canMove} onClick={() => setMode(value)} key={value}>{label}</button>
+        ))}
+      </div>
+      <div className="quoridor-grid" role="group" aria-label="Quoridor grid" style={{ position: "relative", width: boardPx, height: boardPx, display: "grid", gridTemplateColumns: `repeat(${size}, ${QUORIDOR_CELL}px)`, gridTemplateRows: `repeat(${size}, ${QUORIDOR_CELL}px)`, gap: QUORIDOR_GAP }}>
+        {Array.from({ length: size * size }).map((_, index) => {
+          const row = Math.floor(index / size);
+          const column = index % size;
+          const isP1 = meta.pawns.p1.row === row && meta.pawns.p1.column === column;
+          const isP2 = meta.pawns.p2.row === row && meta.pawns.p2.column === column;
+          return (
+            <button
+              type="button"
+              className={`quoridor-cell ${isP1 ? "pawn-p1" : ""} ${isP2 ? "pawn-p2" : ""}`}
+              aria-label={`Row ${row + 1}, column ${column + 1}${isP1 ? ", South pawn" : isP2 ? ", North pawn" : ""}`}
+              disabled={!canMove}
+              onClick={() => place(row, column)}
+              style= display: "grid", placeItems: "center", borderRadius: 6, background: (row + column) % 2 ? "rgba(255,255,255,0.04)" : "rgba(255,255,255,0.08)" 
+              key={index}
+            >
+              {isP1 ? <span style= width: 22, height: 22, borderRadius: "50%", background: "#4aa3ff"  /> : isP2 ? <span style= width: 22, height: 22, borderRadius: "50%", background: "#ff6b6b"  /> : null}
+            </button>
+          );
+        })}
+        {meta.walls.map((wall, index) => {
+          const style: CSSProperties = wall.orientation === "h"
+            ? { position: "absolute", left: wall.column * step, top: wall.row * step + QUORIDOR_CELL - 1, width: 2 * QUORIDOR_CELL + QUORIDOR_GAP, height: 6, background: "#ffd166", borderRadius: 3 }
+            : { position: "absolute", top: wall.row * step, left: wall.column * step + QUORIDOR_CELL - 1, width: 6, height: 2 * QUORIDOR_CELL + QUORIDOR_GAP, background: "#ffd166", borderRadius: 3 };
+          return <span className="quoridor-wall" aria-hidden="true" style={style} key={index} />;
+        })}
+      </div>
+    </div>
+  );
+}
