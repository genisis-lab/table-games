+        <button type="button" className="mode-button" disabled={!canMove || meta.pot <= 0} onClick={() => onMove({ column: 0, action: "bank" })}>Bank{meta.pot > 0 ? ` ${meta.pot}` : ""}</button>
+      </div>
+    </div>
+  );
+}
 
