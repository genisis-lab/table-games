+const MEMORY_ICONS = ["\ud83c\udf52", "\ud83c\udf4b", "\ud83d\udd14", "\u2b50", "\ud83c\udf40", "\ud83d\udc8e", "\ud83c\udfb2", "\ud83d\ude80", "\ud83c\udfb8", "\ud83c\udf38", "\ud83c\udf69", "\u26a1"];
