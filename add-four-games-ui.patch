+        {last ? (last.wiped ? `${playerNameFor(room.gameId, last.roller)} rolled snake eyes \u2014 score wiped!` : last.bust ? `${playerNameFor(room.gameId, last.roller)} busted the pot.` : `${playerNameFor(room.gameId, last.roller)} added ${last.gained} to the pot.`) : ""}
+      </div>
+      <div className="dice-duel-actions" style= display: "flex", gap: 12 >
